# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted (used for email verification links).
APP_URL="https://brettspiele-online.eu"
PORT=3000

# ==============================================================================
# MARIADB / MYSQL DATENBANK-ANBINDUNG
# ==============================================================================
# Trage hier deine MariaDB-Verbindungsdaten für deinen Linux-Server ein.
# Die Tabellen (users, email_verification_tokens, match_history etc.) werden
# beim ersten Server-Start automatisch via Migrations-Script angelegt!
DB_HOST="localhost"
DB_PORT="3306"
DB_USER="famplay_user"
DB_PASSWORD="dein_sicheres_mariadb_passwort"
DB_NAME="famplay_brettspiele"

# ==============================================================================
# JWT AUTHENTIFIZIERUNG
# ==============================================================================
# Geheimer Schlüssel zur Signierung der Session-Tokens (Pflicht-Login).
JWT_SECRET="dein_geheimer_jwt_schluessel_mindestens_32_zeichen"

# ==============================================================================
# E-MAIL SERVER (SMTP)
# ==============================================================================
# SMTP-Zugangsdaten für den automatischen E-Mail-Versand (Verifizierungs-Codes,
# Aktivierungslinks, Willkommensnachrichten und Passwort-Zurücksetzen).
SMTP_HOST="localhost"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM='"FamPlay Brettspiele" <noreply@brettspiele-online.eu>'
